# Copy this file to .env and fill in YOUR values.
# Git ignores .env — do not commit real keys.

# At least 32 characters. Generate a random string; do not reuse someone else's.
Jwt__Secret=replace-with-a-random-string-at-least-32-chars
# Cursor Apps secret name (same value): JWT_SECRET

# Create your own key at https://aistudio.google.com/apikey
Gemini__ApiKey=your-gemini-api-key
# Cursor Apps secret name (same value): GEMINI_API_KEY

# Optional. Cursor Apps inject DATABASE_URL; the app maps it automatically.
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=docinteldb;Username=docintel;Password=your-local-password

# Optional Qdrant Cloud (leave unset for local docker-compose).
# Qdrant__Host=xxxxxxxx.us-east-1-0.aws.cloud.qdrant.io
# Qdrant__Port=6334
# Qdrant__Https=true
# Qdrant__ApiKey=your-qdrant-api-key
