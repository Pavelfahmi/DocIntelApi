# Copy this file to .env and fill in YOUR values.
# Git ignores .env — do not commit real keys.

# At least 32 characters. Generate a random string; do not reuse someone else's.
Jwt__Secret=replace-with-a-random-string-at-least-32-chars

# Create your own key at https://aistudio.google.com/apikey
Gemini__ApiKey=your-gemini-api-key
